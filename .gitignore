# Archivos de datos de negocio (obras, consultas OSA, resultados y logs) -
# no se versionan: son pesados, cambian cada trimestre y contienen data
# comercial que no debe vivir en el historial de git.
*.xlsx
*.xls
!ejemplo*.xlsx

__pycache__/
*.pyc
.venv/
venv/

# artefactos de empaquetado (PyInstaller)
build/
dist/
*.spec

# progreso de revision manual de cada corrida (datos de negocio, no codigo)
sesiones_revision/*.json
